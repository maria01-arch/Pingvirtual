# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to GitHub.

NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only keys
FIVESIM_API_KEY=your-5sim-api-key
HEROSMS_API_KEY=your-herosms-api-key
PAYSTACK_SECRET_KEY=your-paystack-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public - used to build the Paystack callback URL
NEXT_PUBLIC_SITE_URL=https://pingvirtual.vercel.app
